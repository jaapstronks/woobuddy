# =============================================================================
# WOO Buddy — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your setup.
# Never commit .env to version control.

# -----------------------------------------------------------------------------
# No LLM
# -----------------------------------------------------------------------------
# WOO Buddy runs detection on regex + Deduce + wordlists + structure
# heuristics. There is no LLM anywhere in the codebase, so there are no
# LLM/Ollama settings to configure here. If a future contributor revives a
# local LLM verification pass, see docs/reference/llm-revival.md.

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=woobuddy
POSTGRES_PASSWORD=woobuddy
POSTGRES_DB=woobuddy
DATABASE_URL=postgresql+asyncpg://woobuddy:woobuddy@postgres:5432/woobuddy

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# API base URL the browser calls. Match this to your workflow:
#   - Docker Compose (`docker compose up`)       → http://localhost:8100
#   - Bare-metal uvicorn (`uvicorn app.main:app`) → http://localhost:8000
# Both ports are allowed by the frontend CSP, so switching is safe.
PUBLIC_API_URL=http://localhost:8100

# -----------------------------------------------------------------------------
# Lead capture (optional)
# -----------------------------------------------------------------------------
# Needed only if you run the landing-page contact form. Mail goes through
# Dreamkit's own EU infra: Scaleway TEM for the notification, Listmonk for
# the optional newsletter list.
#
# In production these are NOT read from this file. deploy/deploy.sh writes
# them into /opt/woobuddy/.env and docker-compose.prod.yml passes them into
# the api container; deploy/install.sh refuses to deploy when they are
# missing. See deploy/README.md.
#
# Scaleway TEM (transactional email). Every submission fires an email to
# NOTIFICATION_EMAIL so the operator sees the message. Auth is the Scaleway
# secret key (X-Auth-Token); SCALEWAY_PROJECT_ID scopes the send. The From
# address must sit on a verified TEM sending domain. The hosted tier sends
# as hallo@woobuddy.nl; self-hosters point this at their own verified
# domain (add the SPF and DKIM records Scaleway returns).
# Leave SCALEWAY_SECRET_KEY empty in local development.
SCALEWAY_SECRET_KEY=
SCALEWAY_PROJECT_ID=
SCALEWAY_TEM_REGION=fr-par
TEM_FROM_EMAIL=hallo@woobuddy.nl
TEM_FROM_NAME=WOO Buddy
NOTIFICATION_EMAIL=jaap@jaapstronks.nl
#
# Listmonk (self-hosted, EU) — the optional newsletter list. WOO Buddy runs
# the double opt-in itself (#76): it mails the confirmation, and only when
# the recipient clicks does the address reach Listmonk through the admin
# API. That needs an API user — Listmonk → Admin → Users → New → type API,
# with a role granting lists:get and subscribers:get / subscribers:manage.
# LEADS_CONFIRM_SECRET signs the confirmation link (any long random string;
# rotating it invalidates links in flight, a 48-hour window at most).
# PUBLIC_SITE_URL is where that link points — the public frontend origin,
# not the API.
#
# Leave any of these empty to disable the newsletter opt-in; the contact
# form keeps working and the checkbox becomes a no-op.
LISTMONK_URL=https://listmonk.dreamkit.eu
LISTMONK_LIST_UUID=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
LEADS_CONFIRM_SECRET=
PUBLIC_SITE_URL=https://woobuddy.nl

# -----------------------------------------------------------------------------
# File-picker OAuth apps (#51)
# -----------------------------------------------------------------------------
# WOO Buddy can ingest PDFs directly from SharePoint / OneDrive / Google Drive
# using each provider's in-browser picker. The file is downloaded straight
# from the provider to the reviewer's browser — it never touches our server.
# See docs/self-hosting/file-picker.md for full setup.
#
# Leave a variable blank to hide that provider's button.

# Microsoft Graph File Picker v8
PUBLIC_MS_PICKER_CLIENT_ID=
# Defaults to https://login.microsoftonline.com/common (multi-tenant)
PUBLIC_MS_PICKER_AUTHORITY=

# Google Picker API
PUBLIC_GOOGLE_PICKER_CLIENT_ID=
PUBLIC_GOOGLE_PICKER_API_KEY=
PUBLIC_GOOGLE_PICKER_APP_ID=
