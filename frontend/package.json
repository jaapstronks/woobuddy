		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^25.9.3",
		"svelte": "^5.56.6",
		"svelte-check": "^4.7.3",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@shoelace-style/shoelace": "^2.20.0",
		"fflate": "^0.8.3",
		"lucide-svelte": "^1.0.1",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^5.7.284",
		"tailwindcss": "^4.3.3",
		"tesseract.js": "^7.0.0"
	}
